{
  "name": "speaking-coach",
  "version": "0.1.0",
  "private": true,
  "description": "英語學習 App —— 六種模式，發音評估用 Azure Speech 的客觀分數",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "test:ui": "node test/ui.mjs",
    "test:layout": "node test/layout.mjs",
    "test:e2e": "node test/e2e.mjs",
    "sentences:import": "node scripts/import-sentences.mjs",
    "translation:import": "node scripts/import-translation.mjs",
    "corpus:baseline": "node scripts/corpus-baseline.mjs",
    "build:vocabulary": "node scripts/build-vocabulary.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "opencc-js": "^1.4.2",
    "tatoeba-sentence-pairs-in-mandarin-chinese-english": "^0.20260520.0"
  }
}
